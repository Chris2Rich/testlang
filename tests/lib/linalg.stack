importc "./libraries/linalg"

// QR decomposition
// ;; linalg.qrd [[3 3 3][2 1 0][5 3 1]]
// ; matmul : linalg.qrd [[3 3 3][2 1 0][5 3 1]]

// Reduced Row Echelon Form
// ; linalg.rref [[1 3 5 7][1 8 2 0][-3 7 8 1][9 3 -7 4]]
// ; linalg.rref [[1 8 2 0][-3 7 8 1][9 3 -7 4]]

// Inverse
// ; linalg.inverse [[2 3][1 -8]]
// ; linalg.inverse [[0 0][0 1]]
// ; linalg.inverse [[0 0][0 0]]
// ; linalg.inverse [[1 8 3 0 2][1 0 99 2 4][98 23 31 23 1][-85 2 -1 -5 6][88 39 12 30 5]]

// Example of floating point error, this should work
// ; linalg.inverse [[0.000000000000000005 0.000000000000000002][0.0000000000000000012 0.00000000000000000003]]

// Eigenvectors and Eigenvalues
// ;; linalg.eigen [[3 3 3][2 1 0][5 3 1]]

// Singular Value Decomposition
// ;;; linalg.svd [[3 3 3][2 1 0][5 3 1]]

// If we perform SVD, we get back USV^T. We therefore can recalculate the original matrix.
// ; matmul : transpose : matmul linalg.svd [[3 3 3][2 1 0][5 3 1]]

// Works for all shapes but we have to transpose for simplicity if we have m < n in mxn matrix
// ; transpose matmul : transpose : matmul linalg.svd transpose [[3 9 17][2 1 -8]]
